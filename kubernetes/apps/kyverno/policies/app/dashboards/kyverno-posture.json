{
  "title": "Kyverno Policy Posture",
  "uid": "kyverno-posture",
  "tags": [
    "kyverno",
    "policy",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "description": "Policy posture from Kyverno's background scan. All policies are audit-only: nothing here is being blocked, these are violations recorded and admitted. See docs/operations/kyverno.md.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Current posture (last background scan)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Failing results",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Results marked fail in the most recent background scan. These are counters that increment once per scan cycle, so a 70m window captures exactly one full hourly pass. The raw counter value is cumulative since controller start and is not a posture number.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "fail",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "Passing results",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Everything evaluated cleanly in the last scan.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(increase(kyverno_validating_policy_results_total{execution_cause=\"background_scan\"}[70m])) - sum(increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "pass",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Policies reporting",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "How many distinct policies produced results in the last scan. If this drops unexpectedly, a policy has stopped evaluating - which looks identical to full compliance.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "count(count by (policy_name) (increase(kyverno_validating_policy_results_total{execution_cause=\"background_scan\"}[70m]) > 0))",
          "legendFormat": "policies",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Failures by policy",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Work through these top down.",
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (policy_name) (increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "{{policy_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Failures by namespace",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Where the violations live.",
      "gridPos": {
        "h": 5,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (resource_namespace) (increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "{{resource_namespace}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Trend (this is the one to watch while fixing)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "Failures over time, by policy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "One point per scan cycle. Lines should trend down as violations get fixed. A line dropping to zero abruptly is worth checking - it can mean fixed, or it can mean the policy stopped evaluating.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (policy_name) (increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "{{policy_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Breakdown",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "title": "Failures by policy and namespace",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "The actionable list. Sort by Value to find the biggest wins.",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (policy_name, resource_namespace) (increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": null,
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Failures",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "policy_name": "Policy",
              "resource_namespace": "Namespace",
              "Value": "Failures"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Failures by resource kind",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Kyverno's autogen expands a policy written for Pods to Deployments, ReplicaSets, DaemonSets, StatefulSets, Jobs and CronJobs. Expect ReplicaSets to dominate - most are historical revisions nobody will act on. Judge real posture on the Pod slice.",
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 14,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (resource_kind) (increase(kyverno_validating_policy_results_total{result=\"fail\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "{{resource_kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Engine health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "title": "Admission requests / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "What the webhook is actually being asked about.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (resource_kind) (rate(kyverno_admission_requests_total[5m]))",
          "legendFormat": "{{resource_kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Admission review latency (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Kyverno sits in the pod creation path. If this climbs, everything creating pods gets slower. All policies here run failurePolicy: Ignore, so a timeout fails open rather than blocking.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kyverno_admission_review_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 500,
      "type": "row",
      "title": "Mutations and exceptions (what the engine is changing and forgiving)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "title": "Resources mutated",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Admissions where a mutate policy actually changed the resource, last 24h. Mutate has no audit mode - it either applies or it does not - so this is the only view of what the engine has silently rewritten.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(increase(kyverno_mutating_policy_results_total{result=\"pass\"}[24h]))",
          "legendFormat": "mutated",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 12,
      "title": "Matched but not mutated",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Resources a mutate policy matched but deliberately left alone - already below the cap, or covered by a matchCondition exclusion such as the drift-detected Helm releases.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(increase(kyverno_mutating_policy_results_total{result=\"skip\"}[24h]))",
          "legendFormat": "skipped",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 13,
      "title": "Resources exempted by PolicyException",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Violations forgiven by a PolicyException in the last scan. These are decisions, not compliance - each one has a recorded reason and approver in its exception. An exemption that vanishes from the report is indistinguishable from a clean result, which is why reportResult is set to skip rather than pass.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(increase(kyverno_validating_policy_results_total{result=\"skip\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": "exempted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 14,
      "title": "Mutations by policy",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "pass = changed, skip = matched and left alone.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (policy_name, result) (increase(kyverno_mutating_policy_results_total[24h]))",
          "legendFormat": "{{policy_name}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 15,
      "title": "Exemptions by policy and namespace",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Which policies are being forgiven, and where. A number climbing here without a matching PR is worth a look - exceptions are permission to violate policy.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (policy_name, resource_namespace) (increase(kyverno_validating_policy_results_total{result=\"skip\", execution_cause=\"background_scan\"}[70m]))",
          "legendFormat": null,
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Exempted",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "policy_name": "Policy",
              "resource_namespace": "Namespace",
              "Value": "Exempted"
            }
          }
        }
      ]
    },
    {
      "id": 16,
      "title": "Mutation and exemption trend",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Mutation volume over time. A steady non-zero rate is normal while Helm re-renders third-party charts; a sudden spike means something is being rewritten repeatedly, which on a drift-detected release would be a mutate/Flux fight.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (policy_name) (increase(kyverno_mutating_policy_results_total{result=\"pass\"}[1h]))",
          "legendFormat": "mutated: {{policy_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]
}
