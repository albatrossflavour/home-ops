  "templating": {
    "list": [
      {
        "name": "pdctng_job",
        "type": "textbox",
        "query": "puppet",
        "options": [
          {
            "selected": true,
            "text": "puppet",
            "value": "puppet"
          }
        ],
        "current": {
          "selected": true,
          "text": "puppet",
          "value": "puppet"
        },
        "hide": 2
      },
      {
        "name": "node_job",
        "type": "textbox",
        "query": "node-exporter",
        "options": [
          {
            "selected": true,
            "text": "node-exporter",
            "value": "node-exporter"
          }
        ],
        "current": {
          "selected": true,
          "text": "node-exporter",
          "value": "node-exporter"
        },
        "hide": 2
      },
      {
        "name": "windows_job",
        "type": "textbox",
        "query": "windows",
        "options": [
          {
            "selected": true,
            "text": "windows",
            "value": "windows"
          }
        ],
        "current": {
          "selected": true,
          "text": "windows",
          "value": "windows"
        },
        "hide": 2
      },
      {
        "name": "pe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(puppet_exporter_nodes,alias)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_exporter_nodes,alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "PE"
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(puppet_report_timestamp_epoch,environment)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_report_timestamp_epoch,environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "/^(?!rolling_deployment_).*$/",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "label": "Environment"
      },
      {
        "name": "type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(puppet_change_events{alias=~\"${pe}\"},type)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_change_events{alias=~\"${pe}\"},type)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "Resource type"
      },
      {
        "name": "puppetserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "scmserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "cd4peserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Nodes Changing",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_change_nodes{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_change_nodes{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Machines that changed at least one resource of the selected types in their current report. Read it against Resources: a hundred changes on one host is a broken node, a hundred across a hundred hosts is a deployment.",
      "id": 661679969
    },
    {
      "title": "Resources Changing",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_change_events{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_change_events{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Resource events across those nodes' current reports. Higher than the node count whenever a node changed more than one thing, which is usual.",
      "id": 249410636
    },
    {
      "title": "Corrective",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_change_events{corrective=\"true\",type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_change_events{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Of those resources, the ones where Puppet put back something that had drifted rather than applying something somebody shipped. Close to the total means drift rather than a release.",
      "id": 1909090353
    },
    {
      "title": "Names Withheld",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_change_nodes_dropped{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_change_nodes{type=~\"${type}\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Nodes beyond the per-type cap, left out of the table below to bound its size. The count above is never capped, so above zero the table is showing a subset and this is how many it is missing.",
      "id": 307518099
    },
    {
      "title": "Types Withheld",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_change_events_overflow{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_change_events_overflow{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Resource types beyond the 100-type cap, dropped whole from the change data. **Above zero, Resources Changing and Corrective above are undercounts**, because both sum a family this cap bounds, and the table below is missing those types entirely. Names Withheld beside this is the other cap and a different one: that drops nodes from within a type, this drops the type.",
      "id": 303401528
    }
  ],
  "description": "Which nodes are changing, by resource type. The counts are on PDCTNG Convergence; this names the machines behind them, and each one links through to what it actually changed."
}
