    {
      "title": "Longest Security Exposure",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(1, (((time() - max by (node) (last_over_time(timestamp(puppet_patching_data{type=\"security\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} == 0)[30d:1h]))) and on(node) (max by (node) (puppet_patching_data{type=\"security\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0)) or ((max by (node) (puppet_patching_data{type=\"security\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0) * 0 + (30 * 86400))))",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 604800
              },
              {
                "color": "#d03b3b",
                "value": 2592000
              }
            ]
