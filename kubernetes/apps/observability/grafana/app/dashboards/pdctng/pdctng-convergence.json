    {
      "title": "Oldest Report",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(time() - puppet_report_timestamp_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 3600
              },
              {
                "color": "#d03b3b",
                "value": 86400
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Time since the stalest node last reported. Every run-state count on this board is only as current as the report behind it: a node that stopped reporting keeps showing its last outcome indefinitely, and a stale \"unchanged\" is indistinguishable from a fresh one. Report Freshness below names them, oldest first.",
      "id": 740092817
    },
    {
