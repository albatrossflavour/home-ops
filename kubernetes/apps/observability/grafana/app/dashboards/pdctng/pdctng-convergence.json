    {
      "title": "Nodes Needing Attention",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(200, label_replace(puppet_status{state=\"failed\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} == 1, \"reason\", \"Run failed\", \"\", \"\") or label_replace((time() - puppet_report_timestamp_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 3600, \"reason\", \"No report in over an hour\", \"\", \"\") or label_replace(puppet_noop{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} == 1, \"reason\", \"Running in noop\", \"\", \"\") or label_replace(puppet_cache_catalog_status{state!=\"not_used\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} == 1, \"reason\", \"Serving a cached catalog\", \"\", \"\"))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Nothing needs attention, or not collected"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "This node in detail",
                    "url": "/d/pdctng-node-detail?var-node=${__value.text}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reason"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
