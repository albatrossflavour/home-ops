{
  "uid": "pdctng-review",
  "title": "Week in Review",
  "tags": [
    "pdctng",
    "pdctng-reports"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "name": "Code releases",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:release",
            "pe:$pe"
          ],
          "limit": 100
        }
      },
      {
        "name": "Environment deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "dark-purple",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:deploy",
            "pe:$pe"
          ],
          "limit": 100
        }
      },
      {
        "name": "Notes",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:note"
          ],
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "PDCTNG boards",
      "url": "",
      "type": "dashboards",
      "icon": "apps",
      "tags": [
        "pdctng"
      ],
      "asDropdown": true,
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "tooltip": ""
    },
    {
      "title": "Puppet Enterprise Console",
      "url": "https://${puppetserver}",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "Security Compliance Manager",
      "url": "https://${scmserver}",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "Continuous Delivery",
      "url": "https://${cd4peserver}",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "includeAll": false
      },
      {
        "name": "pdctng_job",
        "type": "textbox",
        "query": "puppet",
        "options": [
          {
            "selected": true,
            "text": "puppet",
            "value": "puppet"
          }
        ],
        "current": {
          "selected": true,
          "text": "puppet",
          "value": "puppet"
        },
        "hide": 2
      },
      {
        "name": "node_job",
        "type": "textbox",
        "query": "node-exporter",
        "options": [
          {
            "selected": true,
            "text": "node-exporter",
            "value": "node-exporter"
          }
        ],
        "current": {
          "selected": true,
          "text": "node-exporter",
          "value": "node-exporter"
        },
        "hide": 2
      },
      {
        "name": "windows_job",
        "type": "textbox",
        "query": "windows",
        "options": [
          {
            "selected": true,
            "text": "windows",
            "value": "windows"
          }
        ],
        "current": {
          "selected": true,
          "text": "windows",
          "value": "windows"
        },
        "hide": 2
      },
      {
        "name": "subject",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_review_subject,subject)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_review_subject,subject)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "Subject"
      },
      {
        "name": "pe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_exporter_nodes,alias)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_exporter_nodes,alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "PE"
      },
      {
        "name": "puppetserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "scmserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "cd4peserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Subjects Getting Worse",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count((puppet_review_subject{alias=~\"${pe}\"} - (puppet_review_subject{alias=~\"${pe}\"} offset $__range)) > 0) or (vector(0) and on() (count(puppet_review_subject{alias=~\"${pe}\"} offset $__range) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 4
              }
            ]
          },
          "unit": "locale",
          "noValue": "No comparison yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "How many of the tracked subjects are higher than they were a week ago. Blank rather than 0 when there is no comparison to make, because an unearned zero here would be the most reassuring lie the board could tell. That is expected for the first week after install while the window fills, and it also happens if the review rule group has been turned off or Prometheus has lost the history: the panel cannot tell those apart, so it does not guess. Check that puppet_review_subject itself has a week of data.",
      "id": 842218266
    },
    {
      "title": "Subjects Improving",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count((puppet_review_subject{alias=~\"${pe}\"} - (puppet_review_subject{alias=~\"${pe}\"} offset $__range)) < 0) or (vector(0) and on() (count(puppet_review_subject{alias=~\"${pe}\"} offset $__range) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "No comparison yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "How many are lower than a week ago. Counted rather than shown as a negative so the good news is a number somebody can quote.",
      "id": 308353102
    },
    {
      "title": "Biggest Move",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(1, puppet_review_subject{alias=~\"${pe}\"} - (puppet_review_subject{alias=~\"${pe}\"} offset $__range))",
          "legendFormat": "{{subject}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "No comparison yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "The subject that moved furthest in the wrong direction, named. The table below ranks the rest.",
      "id": 1966126389
    },
    {
      "title": "What got worse",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": [],
      "id": 277496391
    },
    {
      "title": "What Moved, And Which Way",
      "type": "table",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_review_subject{alias=~\"${pe}\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "puppet_review_subject{alias=~\"${pe}\"} offset $__range",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "puppet_review_subject{alias=~\"${pe}\"} - (puppet_review_subject{alias=~\"${pe}\"} offset $__range)",
          "legendFormat": "",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Subject"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Change",
            "desc": true
          }
        ]
      },
      "description": "Every tracked subject: where it is now, where it was at the start of the selected range, and the difference. The column is not labelled with a span because the span is the one you picked. Every subject is counted so that a bigger number is a worse estate, so a positive change is always bad news. Empty for the first week after install while the comparison window fills. The subjects and their PromQL are the review recording-rule group in Hiera, not this board. **On a multi-primary estate, narrow to one PE before reading this table**: the join below keys on subject alone, not on subject and primary together.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "subject",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(subject|Value\\ \\#A|Value\\ \\#B|Value\\ \\#C)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "subject": "Subject",
              "Value #A": "Now",
              "Value #B": "At Range Start",
              "Value #C": "Change"
            },
            "indexByName": {
              "subject": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        }
      ],
      "id": 1193864556
    },
    {
      "title": "How each subject has moved",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": [],
      "id": 1863662745
    },
    {
      "title": "$subject",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_review_subject{subject=~\"$subject\",alias=~\"${pe}\"}",
          "legendFormat": "{{alias}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "never",
            "lineWidth": 1,
            "axisSoftMax": 2
          },
          "unit": "locale",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "This subject over the selected range, with release markers. The tables above compare two instants; this is the shape between them, which is where a step change lining up with a deploy shows itself. One line per primary at All, now that the subject carries one.",
      "repeat": "subject",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "id": 1767052474
    },
    {
      "title": "What is new",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": [],
      "id": 1294470210
    },
    {
      "title": "Nodes That Started Failing This Week",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(20, puppet_status{state=\"failed\",alias=~\"${pe}\"} == 1 unless (puppet_status{state=\"failed\",alias=~\"${pe}\"} offset $__range == 1))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Nothing new started failing this week"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "This node in detail",
                    "url": "/d/pdctng-node-detail?var-node=${__value.text}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "description": "Nodes failing now that were not failing a week ago, so a long-standing failure does not crowd out a new one. Twenty at most. A node that has failed for months is on PDCTNG Triage, which is the work list; this is the change.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(node|environment)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "node": "Node",
              "environment": "Environment"
            },
            "indexByName": {
              "node": 0,
              "environment": 1
            }
          }
        }
      ],
      "id": 1133579666
    },
    {
      "title": "What we did",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": [],
      "id": 46348605
    },
    {
      "title": "Machines Corrected",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(max_over_time(puppet_state_overview{state=\"corrective\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}[$__range])) or (vector(0) and on() (count(puppet_state_overview{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Nodes where Puppet put something back the way it should be. Drift caught and fixed without anybody being paged. **The most machines correcting at once in the selected range**, not a count of distinct machines: doing many changes to one machine and a few to many machines are the same amount of work, so the peak is the honest cheap answer and the distinct count is not worth what it costs. PDCTNG Work Done carries this in full.",
      "id": 1519908976
    },
    {
