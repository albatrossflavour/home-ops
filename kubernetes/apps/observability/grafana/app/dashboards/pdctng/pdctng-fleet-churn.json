  "panels": [
    {
      "title": "Active Nodes",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(puppet_node_lifecycle{state=\"active\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_node_lifecycle{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Nodes PuppetDB currently holds as active.",
      "id": 1947460628
    },
    {
      "title": "Deactivated",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(puppet_node_lifecycle{state=\"deactivated\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_node_lifecycle{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Nodes explicitly deactivated. A growing count is decommissioned hardware that nobody purged, still carrying weight in PuppetDB.",
      "id": 1186604664
    },
