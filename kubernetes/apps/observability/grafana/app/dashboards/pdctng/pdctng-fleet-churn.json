    {
      "title": "Nodes By Lifecycle State",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (state) (puppet_node_lifecycle{alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 25,
            "pointSize": 5,
            "showPoints": "never",
            "lineWidth": 1
          },
          "unit": "locale",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "The fleet split by lifecycle state over the range. Active climbing is growth; deactivated or expired climbing is dead nodes accumulating.",
      "id": 274010372
    },
    {
