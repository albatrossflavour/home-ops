      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(puppet_fact_staleness_seconds{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
