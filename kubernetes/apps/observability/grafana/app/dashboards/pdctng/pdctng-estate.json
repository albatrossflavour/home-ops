        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(10, puppet_classes_per_node{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or bottomk(10, puppet_classes_per_node{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "max by (node) (puppet_report_resources{name=\"Total\",environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} and on(node) (topk(10, puppet_classes_per_node{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or bottomk(10, puppet_classes_per_node{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})))",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "links": [
            {
              "title": "This node in detail",
              "url": "/d/pdctng-node-detail?var-node=${__field.labels.node}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Classes"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Resources"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Classes",
            "desc": true
          }
        ]
      },
      "description": "The ten nodes carrying the most classes and the ten carrying the fewest, against the median beside, with the resource count each one compiles to. A node far below its peers is usually classified into nothing and quietly unmanaged, which every other board on this estate reads as healthy because it is reporting and converging; a node far above is often a host that has accumulated roles nobody removed. Neither is wrong by itself, which is why this names nodes rather than raising an alert. Resources is the second proxy for the same fault, and the pair is the point: few classes and a large catalogue is a host doing a lot from almost no classification. **Do not read either as compile cost.** Measured on this estate, cost per resource comes out 8.8x apart depending on which node you pick, so a resource count converts to nothing.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(node|alias|environment|Value\\ \\#A|Value\\ \\#B)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "node": "Node",
              "alias": "PE",
              "environment": "Environment",
              "Value #A": "Classes",
              "Value #B": "Resources"
            },
            "indexByName": {
              "node": 0,
              "alias": 1,
              "environment": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        }
      ],
      "id": 362836007
    },
