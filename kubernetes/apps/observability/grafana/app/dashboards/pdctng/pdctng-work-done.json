    },
    {
      "title": "Machines Reached, By Kind Of Work",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (task_name) (puppet_orchestrator_job_node_count{alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "{{task_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "displayName": "${__field.labels.task_name}",
          "noValue": "Nothing recorded in this window",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "text": {
          "titleSize": 13,
          "valueSize": 22
        }
      },
      "description": "How many machines each kind of work reached. The tall bars are what would otherwise have been done one machine at a time, by hand.",
      "id": 1504985464
    },
    {
      "title": "Who Started The Work",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count by (owner) (puppet_orchestrator_job_info{alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
