  "panels": [
    {
      "title": "What we did so you did not have to",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Every machine below is checked, corrected and kept current automatically, around the clock, without anyone logging in. This board counts what that actually came to: how much of your estate is being watched, how often, what was patched, what was fixed, and what was delivered."
      },
      "id": 817783028
    },
    {
      "title": "Resources Under Management",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_report_resources{name=\"Total\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_report_resources{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Every file, package, service, user and setting Puppet is holding in place across your estate. Each one is checked on every run and put back if it has moved.",
      "id": 1908261867
    },
    {
      "title": "Checked Every",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "quantile(0.5, puppet_agent_runinterval_seconds{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_agent_runinterval_seconds{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "s",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "How often the typical machine re-checks everything it manages. The middle value across the estate, so a handful of machines on a different schedule cannot skew it.",
      "id": 789006757
    },
    {
      "title": "Checks Per Day",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_report_resources{name=\"Total\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} * on(node) group_left() (86400 / puppet_agent_runinterval_seconds{alias=~\"${pe}\",job=~\"${pdctng_job}\"})) or (vector(0) and on() (count(puppet_report_resources{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "decimals": 0,
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Resources under management multiplied by how often each machine checks them. This many individual things are verified and corrected every day without anyone being asked.",
      "id": 1761195250
    },
    {
      "title": "Machines Patched",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(puppet_patch_run{alias=~\"${pe}\",job=~\"${pdctng_job}\"} > (time() - $__range_s)) or (vector(0) and on() (count(puppet_patch_run{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Machines whose most recent patch run falls inside the selected time range. Follows the time picker. Nobody logged into these to do it.",
      "id": 96698596
    },
    {
      "title": "Machines Reached",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_orchestrator_job_nodes_total{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_orchestrator_job_nodes_total{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Machines reached by bulk operations. One operation across 40 machines counts 40, because that is 40 logins nobody had to make. **Since the exporter last restarted**, which is not the same as the selected range and is the honest thing this can say. The counter is held in memory and resets with the daemon, so a deploy sets it back to zero; see R625.",
      "id": 1711685954
    },
    {
      "title": "Operations Completed",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_orchestrator_jobs_total{state=\"finished\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_orchestrator_jobs_total{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Bulk operations run across many machines at once that completed successfully. **Since the exporter last restarted**, which is not the same as the selected range and is the honest thing this can say. Counts jobs reaching a finished state, not every node in them succeeding (R507). The counter is held in memory and resets with the daemon, so a deploy sets it back to zero; see R625.",
      "id": 1801111093
    },
    {
      "title": "Machines Corrected",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max_over_time(sum(puppet_state_overview{state=\"corrective\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})[$__range:]) or (vector(0) and on() (count(puppet_state_overview{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Machines that put something back the way it should be, without anyone asking, at the busiest moment in the selected range. Follows the time picker, and reads the peak rather than an accumulation because the underlying figure is a point-in-time count of machines currently correcting. Good that it was caught; see the drift row for whether it is getting worse.",
      "id": 1519908976
    },
    {
      "title": "Machines kept patched",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": [],
      "id": 1668084023
    },
    {
      "title": "Machines Patched, By Group",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, count by (patch_group) (puppet_patch_run{alias=~\"${pe}\",job=~\"${pdctng_job}\"} > (time() - $__range_s)))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Nothing recorded in this window"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Patch group"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Machines",
            "desc": true
          }
        ]
      },
      "description": "Machines patched in the selected range, by patch group, ten largest. Bounded because an estate can carry one group per machine, which turns an unbounded chart into a wall of ones.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(patch_group|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "patch_group": "Patch group",
              "Value": "Machines"
            },
            "indexByName": {
              "patch_group": 0,
              "Value": 1
            }
          }
        }
      ],
      "id": 1520054197
    },
    {
