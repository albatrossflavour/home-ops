  "panels": [
    {
      "title": "Modules Deployed",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (module) (puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"})) or (vector(0) and on() (count(puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Distinct modules deployed across the environments the collector reads.",
      "id": 1082411022
    },
    {
      "title": "Modules With Version Drift",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (module) (count by (module, version) (puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"})) > 1) or (vector(0) and on() (count(puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Modules deployed at more than one version across environments. On a single-environment estate this is zero; it lights up where two environments have drifted apart on the same module.",
      "id": 1153865037
    },
    {
      "title": "Environments With Modules",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (environment) (puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"})) or (vector(0) and on() (count(puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Environments the module inventory covers. Fewer than the Environments board counts, because an environment with no module data does not appear here.",
      "id": 644689652
    },
    {
      "title": "Modules Dropped (overflow)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(puppet_module_version_overflow{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Modules beyond the per-environment cap, dropped to bound cardinality. Above zero, the inventory below is truncated.",
      "id": 1106435531
    },
    {
      "title": "Where versions drift",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": [],
      "id": 1911752638
    },
    {
      "title": "Modules At Multiple Versions",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"} and on(module) (count by (module) (count by (module, version) (puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"})) > 1)",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Every module is at one version"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Module"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Module",
            "desc": false
          }
        ]
      },
      "description": "Modules deployed at more than one version, one row per environment holding a version. Two rows for a module means two environments disagree on it. Empty is the healthy case.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(module|version|environment)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "module": "Module",
              "version": "Version",
              "environment": "Environment"
            },
            "indexByName": {
              "module": 0,
              "version": 1,
              "environment": 2
            }
          }
        }
      ],
      "id": 512943881
    },
    {
      "title": "All deployed modules",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": [],
      "id": 207578822
    },
    {
      "title": "Deployed Module Versions",
      "type": "table",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "puppet_module_version{alias=~\"${pe}\",job=~\"${pdctng_job}\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Module"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Module",
            "desc": false
          }
        ]
      },
      "description": "Every module the collector read, its version, and the environment it is deployed in. The module set is already cap-bounded, so this is the full picture up to the overflow tile above.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(module|version|environment)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "module": "Module",
              "version": "Version",
              "environment": "Environment"
            },
            "indexByName": {
              "module": 0,
              "version": 1,
              "environment": 2
            }
          }
        }
      ],
      "id": 1806972244
    }
  ],
  "description": "Which modules are deployed at which versions in which environments, and where environments disagree on a module's version. What the estate is made of is on PDCTNG Estate."
}
