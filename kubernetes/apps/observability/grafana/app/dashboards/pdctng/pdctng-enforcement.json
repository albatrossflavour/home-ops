  "panels": [
    {
      "title": "What this board is, and what it is not",
      "type": "text",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Puppet corrects at run interval, so this board can bound drift exposure, never measure it.** With a thirty minute run interval, the longest a machine can sit wrong before Puppet notices is thirty minutes; the true figure, how wrong and for how long inside that window, is unknowable from here. Nothing on this board says who caused a drift or how.\n\n**Noop nodes are excluded throughout.** A noop node reports what it would have corrected, which looks identical to enforcement on a naive drift panel and is not enforcement at all. See Evidence Quality's Claimable funnel for which nodes that leaves.\n"
      },
      "id": 497422005
    },
    {
      "title": "Is the mechanism working?",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": [],
      "id": 460407404
    },
    {
      "title": "Drift Corrected",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(puppet_changes_total{kind=\"corrective\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}[$__range])) or (vector(0) and on() (count(puppet_exporter_collector_success{collector=\"change_types\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "short",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Resources Puppet found changed away from policy and put back, over the selected range. Lead with this: it is the argument in one number, that policy is being reasserted without anyone being paged.",
