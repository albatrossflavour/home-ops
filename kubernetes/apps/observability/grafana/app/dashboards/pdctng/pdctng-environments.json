      "title": "Continuous Delivery",
      "url": "https://${cd4peserver}",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "includeAll": false
      },
      {
        "name": "pdctng_job",
        "type": "textbox",
        "query": "puppet",
        "options": [
          {
            "selected": true,
            "text": "puppet",
            "value": "puppet"
          }
        ],
        "current": {
          "selected": true,
          "text": "puppet",
          "value": "puppet"
        },
        "hide": 2
      },
      {
        "name": "node_job",
        "type": "textbox",
        "query": "node-exporter",
        "options": [
          {
            "selected": true,
            "text": "node-exporter",
            "value": "node-exporter"
          }
        ],
        "current": {
          "selected": true,
          "text": "node-exporter",
          "value": "node-exporter"
        },
        "hide": 2
      },
      {
        "name": "windows_job",
        "type": "textbox",
        "query": "windows",
        "options": [
          {
            "selected": true,
            "text": "windows",
            "value": "windows"
          }
        ],
        "current": {
          "selected": true,
          "text": "windows",
          "value": "windows"
        },
        "hide": 2
      },
      {
        "name": "pe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_exporter_nodes,alias)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_exporter_nodes,alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "PE"
      },
      {
        "name": "puppetserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "scmserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "cd4peserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Environments Deployed",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Durable environments deployed on the primary, from the environment directories themselves, so this counts empty ones too. Ephemeral CD4PE branches are excluded and counted separately. This is the widest count of the four the family carries: Code Releases counts only those Code Manager deployed to, Module Drift only those with module data, and Fleet Composition breaks nodes down by environment rather than counting environments at all.",
      "id": 69079476
    },
    {
      "title": "Environments With No Nodes",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count((puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) unless on(environment) (sum by (environment) (puppet_node_count{environment!=\"all\",environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}))) or (vector(0) and on() (count(puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Durable environments with nothing pinned to them: deployed on the primary but no node reports under them. These are the abandoned control-repo branches, invisible to any report-derived view because they carry no series of their own. Node population is the inventory count (puppet_node_count), not code_id, so it is right even where code_id does not populate.",
      "id": 693365042
    },
    {
      "title": "Ephemeral Environments Seen",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(count by (environment) (puppet_code_id{environment=~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})) or (vector(0) and on() (count(puppet_code_id{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "noValue": "Not collected"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Transient CD4PE environments (rolling deployments, impact analyses) still carrying series. A handful in flight is normal; a number that keeps climbing is sprawl PuppetDB never pruned.",
      "id": 1154154426
    },
    {
      "title": "Oldest Environment",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(time() - puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 2592000
              },
              {
                "color": "#d03b3b",
                "value": 7776000
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Time since the stalest durable environment was last deployed (its directory mtime). A high value is a branch nobody has deployed to in a long while, worth deciding whether it should still exist. The 30 and 90 day steps are a starting guess, tunable.",
      "id": 1180398542
    },
    {
      "title": "By age and size",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": [],
      "id": 1989199958
    },
    {
      "title": "Environments By Age",
      "type": "table",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (environment) (time() - puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (environment) (puppet_node_count{environment!=\"all\",environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (max by (environment) (puppet_environment_last_deploy_epoch{environment!~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) * 0)",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Age",
            "desc": true
          }
        ]
      },
      "description": "Every durable environment, how many nodes report under it (inventory count, not code_id), and how long since it was last deployed (directory mtime), stalest first. Environments with no nodes appear here with a count of 0, which report-derived views cannot show.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "environment",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(environment|Value\\ \\#A|Value\\ \\#B)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "environment": "Environment",
              "Value #A": "Age",
              "Value #B": "Nodes"
            },
            "indexByName": {
              "environment": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        }
      ],
      "id": 909312632
    },
    {
      "title": "Ephemeral sprawl",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": [],
      "id": 870209235
    },
    {
      "title": "Ephemeral Environments",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "time() - puppet_code_deploy_timestamp_epoch{environment=~\"rolling_deployment_.*|.*_cdpe_ia_.*\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No ephemeral environments lingering"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Age",
            "desc": true
          }
        ]
      },
      "description": "The transient CD4PE environments still carrying series, and how long each has lingered. Empty is the healthy case; rows here are rolling-deployment and impact-analysis branches PuppetDB has not aged out yet.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(environment|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "environment": "Environment",
              "Value": "Age"
            },
            "indexByName": {
              "environment": 0,
              "Value": 1
            }
          }
        }
      ],
      "id": 1335242692
    }
  ],
  "description": "How many environments are deployed, how old each one's code is, and which carry no nodes. Age is the environment directory's mtime (its last deploy), read off the primary, so node-less branches are counted too. A long-untouched or empty environment is usually an abandoned control-repo branch. What the estate is made of is on PDCTNG Estate; how it is classified is on PDCTNG Classification."
}
