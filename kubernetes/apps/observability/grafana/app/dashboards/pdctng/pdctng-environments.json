{
  "uid": "pdctng-environments",
  "title": "Environments",
  "tags": [
    "pdctng",
    "pdctng-enforcement"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "name": "Code releases",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:release",
            "pe:$pe"
          ],
          "limit": 100
        }
      },
      {
        "name": "Environment deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "dark-purple",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:deploy",
            "pe:$pe"
          ],
          "limit": 100
        }
      },
      {
        "name": "Notes",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:note"
          ],
          "limit": 100
        }
      }
    ]
  },
  "links": [
