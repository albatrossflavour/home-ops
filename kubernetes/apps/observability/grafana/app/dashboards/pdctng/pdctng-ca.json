  "panels": [
    {
      "title": "CA Expires In",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min by (alias) (puppet_ca_expires_epoch{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) - time()",
          "legendFormat": "{{alias}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": -3153600000
              },
              {
                "color": "#fab219",
                "value": 2592000
              },
              {
                "color": "#0ca30c",
                "value": 7776000
              }
            ]
          },
          "unit": "s",
          "noValue": "No CA metrics"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Time until the soonest CA certificate expiry, root or intermediate. When the CA expires, everything it signed stops working at once. Amber at ninety days, because replacing a CA is a project with lead time. One value per PE (R93): a min without by (alias) would report only the soonest across the estate at All.",
      "id": 951886890
    },
    {
      "title": "CRL Valid For",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "min by (alias) (puppet_crl_next_update_epoch{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) - time()",
          "legendFormat": "{{alias}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": -3153600000
              },
              {
                "color": "#fab219",
                "value": 0
              },
              {
                "color": "#0ca30c",
                "value": 2592000
              }
            ]
          },
          "unit": "s",
          "noValue": "No CRL metrics"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Time until the soonest CRL nextUpdate. An expired CRL presents as the whole estate refusing to authenticate at once. One value per PE (R93).",
      "id": 477711776
    },
    {
      "title": "CA Certificates",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_ca_expires_epoch{alias=~\"${pe}\",job=~\"${pdctng_job}\"} - time()",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No CA metrics"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Certificate"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expires in"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Expires in",
            "desc": false
          }
        ]
      },
      "description": "Every certificate in the CA bundle and its time to expiry. The tile shows the soonest; the renewal plan needs to know which one that is.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(subject|alias|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "subject": "Certificate",
              "alias": "PE",
              "Value": "Expires in"
            },
            "indexByName": {
              "subject": 0,
              "alias": 1,
              "Value": 2
            }
          }
        }
      ],
      "id": 479828936
    },
