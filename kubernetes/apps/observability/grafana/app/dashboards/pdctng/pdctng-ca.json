          "options": {
            "renameByName": {
              "issuer": "Issuer",
              "alias": "PE",
              "Value": "Valid for"
            },
            "indexByName": {
              "issuer": 0,
              "alias": 1,
              "Value": 2
            }
          }
        }
      ],
      "id": 39184864
    },
    {
      "title": "Is signing working?",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": [],
      "id": 306668307
    },
    {
      "title": "CSRs Waiting",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (alias) (puppet_ca_certificate_count{state=\"requested\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "{{alias}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "unit": "locale",
          "noValue": "No CA metrics"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Certificate signing requests waiting to be signed. On an autosign estate anything sitting here means autosign is broken and the node cannot join; on a manual-signing estate this is the work queue. One value per PE (R93); the registry always emits this state, so a healthy PE reads a green zero rather than needing a synthesised one.",
      "id": 371132206
    },
