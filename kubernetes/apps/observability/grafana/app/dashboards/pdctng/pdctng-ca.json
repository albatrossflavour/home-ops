    {
      "title": "Expiry Spread",
      "type": "bargauge",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(((puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0) - time()) < 0) or (vector(0) and on() (count(puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "Expired",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "count((((puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0) - time()) >= 0) < (7 * 86400)) or (vector(0) and on() (count(puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "Under 7 days",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "count((((puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0) - time()) >= (7 * 86400)) < (14 * 86400)) or (vector(0) and on() (count(puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "7 to 14 days",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "count((((puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0) - time()) >= (14 * 86400)) < (30 * 86400)) or (vector(0) and on() (count(puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "14 to 30 days",
          "refId": "D",
          "instant": true
        },
        {
          "expr": "count((((puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0) - time()) >= (30 * 86400)) < 7776000) or (vector(0) and on() (count(puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "30 to 90 days",
          "refId": "E",
          "instant": true
        },
        {
          "expr": "count(((puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0) - time()) >= 7776000) or (vector(0) and on() (count(puppet_certificate_expires_epoch{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "Over 90 days",
          "refId": "F",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Expired"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Under 7 days"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "7 to 14 days"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ec835a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "text": {
          "titleSize": 13,
          "valueSize": 22
        }
      },
      "description": "Node certificates bucketed by time to expiry. **On an auto-renewing estate the middle two buckets are the healthy steady state, not a warning**: an agent renews its own certificate once it is within hostcert_renewal_interval of expiry and the CA reissues for auto-renewal-cert-ttl, so every working certificate cycles forever between the two. Only the buckets below the renewal interval mean renewal was due and has not happened. A tall near bucket is a cert cliff: a batch signed together expires together, and that renewal work wants scheduling before it arrives.",
      "id": 990312557
    },
