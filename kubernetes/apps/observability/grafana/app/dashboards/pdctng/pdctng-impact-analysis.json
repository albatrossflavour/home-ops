{
  "uid": "pdctng-impact-analysis",
  "title": "Impact Analysis",
  "tags": [
    "pdctng",
    "pdctng-enforcement"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "name": "Code releases",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:release",
            "pe:$pe"
          ],
          "limit": 100
        }
      },
      {
        "name": "Environment deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "dark-purple",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:deploy",
            "pe:$pe"
          ],
          "limit": 100
        }
      },
      {
        "name": "Notes",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "type": "tags",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "pdctng:note"
          ],
          "limit": 100
        }
      }
    ]
  },
  "links": [
    {
      "title": "PDCTNG boards",
      "url": "",
      "type": "dashboards",
      "icon": "apps",
      "tags": [
        "pdctng"
      ],
      "asDropdown": true,
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true,
      "tooltip": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "includeAll": false
      },
      {
        "name": "pdctng_job",
        "type": "textbox",
        "query": "puppet",
        "options": [
          {
            "selected": true,
            "text": "puppet",
            "value": "puppet"
          }
        ],
        "current": {
          "selected": true,
          "text": "puppet",
          "value": "puppet"
        },
        "hide": 2
      },
      {
        "name": "node_job",
        "type": "textbox",
        "query": "node-exporter",
        "options": [
          {
            "selected": true,
            "text": "node-exporter",
            "value": "node-exporter"
          }
        ],
        "current": {
          "selected": true,
          "text": "node-exporter",
          "value": "node-exporter"
        },
        "hide": 2
      },
      {
        "name": "windows_job",
        "type": "textbox",
        "query": "windows",
        "options": [
          {
            "selected": true,
            "text": "windows",
            "value": "windows"
          }
        ],
        "current": {
          "selected": true,
          "text": "windows",
          "value": "windows"
        },
        "hide": 2
      },
      {
        "name": "pe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_exporter_nodes,alias)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_exporter_nodes,alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "PE"
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_report_timestamp_epoch,environment)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_report_timestamp_epoch,environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "/^(?!rolling_deployment_).*$/",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "label": "Environment"
      }
    ]
  },
  "panels": [
    {
      "title": "What the latest analysis predicts",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1722483246
    },
    {
      "title": "Compile Failures Found",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(puppet_cd4pe_predicted_compile_failures{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_cd4pe_predicted_compile_failures{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "unit": "locale",
          "noValue": "No analysis has run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Catalogue compilation failures the latest analysis found. **Above zero this deploy breaks something**, and the size tiles beside it stop mattering. Zero is the answer that lets the other two be interesting.",
      "id": 414744444
    },
    {
      "title": "Nodes The Deploy Touches, By Environment",
      "type": "bargauge",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_cd4pe_predicted_nodes{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "displayName": "${__field.labels.environment}",
          "noValue": "No analysis has run, or not collected",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "text": {
          "titleSize": 13,
          "valueSize": 22
        }
      },
      "description": "Nodes the latest finished analysis predicts each environment's deploy affects. **Per environment and never summed**: CD4PE analyses a change against one environment, so a total across them describes a deploy nobody is making.",
      "id": 1543787585
    },
    {
      "title": "Resource Changes Predicted, By Environment",
      "type": "bargauge",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_cd4pe_predicted_resource_changes{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "displayName": "${__field.labels.environment}",
          "noValue": "No analysis has run, or not collected",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "text": {
          "titleSize": 13,
          "valueSize": 22
        }
      },
      "description": "Resource changes the analysis predicts. Read against the nodes beside it: the same change count spread over eight nodes and over eight hundred are very different mornings, which is the pairing Code Releases uses for the observed half of the same question.",
      "id": 74807900
    },
    {
      "title": "Is the impact growing?",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": [],
      "id": 318686303
    },
    {
      "title": "Predicted Impact Over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (environment) (puppet_cd4pe_predicted_nodes{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "Nodes {{environment}}",
          "refId": "A"
        },
        {
          "expr": "max by (environment) (puppet_cd4pe_predicted_resource_changes{environment=~\"${environment}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "Resource changes {{environment}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "locale",
          "noValue": "Nothing recorded in this window",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "What successive analyses predicted, by environment. **One analysis is a number; the shape is the finding** -- a change set growing deploy after deploy is a branch that has been open too long, and it is visible here before it is visible anywhere else.",
      "id": 1554088841
    }
  ],
  "description": "What CD4PE predicts the next deploy will do, per environment, before it happens. Code Releases answers the same question afterwards."
}
