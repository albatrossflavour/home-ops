        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(puppet_class_group_count{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) or (vector(0) and on() (count(puppet_class_group_count{alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
