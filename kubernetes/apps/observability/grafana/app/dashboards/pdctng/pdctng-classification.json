              {
                "color": "#8e949f",
                "value": null
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Distinct Puppet classes referenced by at least one group. The breakdown is in Most-Referenced Classes below.",
      "id": 269645382
    },
    {
      "title": "The node-group hierarchy",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": [],
      "id": 777816587
    },
    {
      "title": "Node Group Hierarchy",
      "type": "table",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_node_group_info{alias=~\"${pe}\",job=~\"${pdctng_job}\"}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "max by (group_uuid) (puppet_node_group_nodes{alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Group"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "This node group in the PE console",
                    "url": "https://${puppetserver}/#/inventory/groups/${__data.fields[\"Group UUID\"]}/rules",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Order"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Nodes"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Has rules"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Classes"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Group UUID"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Order",
            "desc": false
          }
        ]
      },
      "description": "The node-group tree, indented as the PE console shows it. Nodes is how many machines match the group's rule, counted by asking the Classifier to translate that rule and running the answer past PuppetDB, so it is PE's own arithmetic and includes pinned nodes. A blank Nodes cell means the group has no rule to match on, which is what Has rules distinguishes: a group that matches nodes dynamically from one that only nests others. Classes is how many classes the group assigns directly.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "group_uuid",
            "mode": "outer"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "sort_order",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(sort_order|display_name|Value\\ \\#B|environment|parent_group|has_rules|Value\\ \\#A|group_uuid)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "sort_order": "Order",
              "display_name": "Group",
              "Value #B": "Nodes",
              "environment": "Environment",
              "parent_group": "Parent",
              "has_rules": "Has rules",
              "Value #A": "Classes",
              "group_uuid": "Group UUID"
            },
            "indexByName": {
              "sort_order": 0,
              "display_name": 1,
              "Value #B": 2,
              "environment": 3,
              "parent_group": 4,
              "has_rules": 5,
              "Value #A": 6,
              "group_uuid": 7
            }
          }
        }
      ],
      "id": 1189070027
    },
    {
      "title": "Where the classes are",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": [],
      "id": 1544264990
    },
    {
      "title": "Classes Per Group",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(20, puppet_classes_per_group{alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Group"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Classes"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Classes",
            "desc": true
          }
        ]
      },
      "description": "The twenty groups assigning the most classes directly. A group carrying a large share of the estate's classes is where a change lands hardest.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(name|environment|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Group",
              "environment": "Environment",
              "Value": "Classes"
            },
            "indexByName": {
              "name": 0,
              "environment": 1,
              "Value": 2
            }
          }
        }
      ],
      "id": 1449961280
    },
    {
      "title": "Most-Referenced Classes",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(25, puppet_class_group_count{alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Class"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Groups"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Groups",
            "desc": true
          }
        ]
      },
      "description": "The twenty-five classes referenced by the most groups. A class in many groups is shared estate-wide, so a change to it is broad; a class in one group is local to it.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(class_name|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "class_name": "Class",
              "Value": "Groups"
            },
            "indexByName": {
              "class_name": 0,
              "Value": 1
            }
          }
        }
      ],
      "id": 259455877
    },
    {
      "title": "What this board cannot see",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "mode": "markdown",
        "content": "**Classification in code does not appear here.** This board reads the PE node classifier and the roles nodes carry in their certificates. Anything `site.pp` decides is invisible to it: pdctng sees the classes that ended up applied, not the code that chose them.\n\nThat is a real gap and it is deliberately not given a number. The obvious count, classes applied that no group assigns, is dominated by ordinary composition \u2014 a group assigns a role, the role includes its profiles, and the group assigns none of them \u2014 so it measures how roles and profiles work rather than what `site.pp` did.\n"
      },
      "id": 1854464976
    },
