          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "cd4peserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
