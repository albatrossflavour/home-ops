        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Last signed in",
            "desc": false
          }
        ]
      },
      "description": "When each live account last signed in, oldest first. Revoked accounts are left out, since they have already been dealt with. **Accounts that have never signed in are not here either** and are counted in the tile above: a zero would render as 1970 and sort a brand-new account to the top of this list, which is the opposite of the truth.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(login|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "login": "Account",
              "Value": "Last signed in"
            },
            "indexByName": {
              "login": 0,
              "Value": 1
            }
          }
        }
      ],
      "id": 1738493691
    },
