    {
      "title": "Who Holds Each Role",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "puppet_rbac_role_members{alias=~\"${pe}\",job=~\"${pdctng_job}\"} > 0",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "No role has any members, or not collected"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Role"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "description": "Direct membership per role. **Users and groups are counted separately and summing them answers nothing**: a person reaching a role through a group appears under `group`, and how many people that is lives in the identity provider rather than in PE. A role with permissions and nobody in it is tidy; a role nobody remembers granting with people in it is the finding.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(role|member|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "role": "Role",
              "member": "Granted to",
              "Value": "Count"
            },
            "indexByName": {
              "role": 0,
              "member": 1,
              "Value": 2
            }
          }
        }
      ],
      "id": 1988218271
    },
    {
