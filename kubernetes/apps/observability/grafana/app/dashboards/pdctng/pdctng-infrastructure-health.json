      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{pe_infrastructure=\"true\",pe=~\"${installation}\",instance=~\"${instance}\"}",
          "legendFormat": "Total {{instance}}",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{pe_infrastructure=\"true\",pe=~\"${installation}\",instance=~\"${instance}\"}",
          "legendFormat": "Available {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
