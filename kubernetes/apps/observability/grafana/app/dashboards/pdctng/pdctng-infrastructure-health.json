        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Total against available, so the gap between the two lines is what is actually in use. Read the shape rather than the number: available trending steadily down over days with no corresponding workload is a leak, and it will end as the Swapping tile.",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(.*?)([^\\s.]+)\\.[A-Za-z0-9.:-]+$",
            "renamePattern": "$1$2"
          }
        }
      ],
