        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(puppet_server_filesync_duration_seconds{side=\"client\",operation=\"fetch\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 5
              },
              {
                "color": "#d03b3b",
                "value": 30
              }
