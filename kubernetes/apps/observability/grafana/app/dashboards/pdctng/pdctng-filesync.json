    {
      "title": "Storage Operation Times",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "puppet_server_filesync_duration_seconds{side=\"storage\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}",
          "legendFormat": "{{operation}} {{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "The primary side: committing new code, and the pre-commit hook that validates it. A slow pre-commit hook slows every deploy.",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(.*?)([^\\s.]+)\\.[A-Za-z0-9.:-]+$",
            "renamePattern": "$1$2"
          }
        }
      ],
      "id": 824073145
    },
    {
      "title": "Client Operation Times",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
