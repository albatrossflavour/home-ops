      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "File sync commits take the JRuby pool, so a slow sync stalls every compile on that host. Peaks that line up are this board's reason to exist: agents queuing on Puppetserver with no cause visible there, because the cause is here. Peaks that do not line up mean look somewhere else.",
      "id": 467617292
    },
