        ],
        "current": {
          "selected": true,
          "text": "windows",
          "value": "windows"
        },
        "hide": 2
      },
      {
        "name": "interval",
        "type": "interval",
        "query": "5m,10m,30m,1h,6h,12h,1d",
        "refresh": 2,
        "options": [
          {
            "selected": true,
            "text": "auto",
            "value": "$__auto_interval_interval"
          },
          {
            "selected": false,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": false,
            "text": "10m",
            "value": "10m"
          },
          {
            "selected": false,
            "text": "30m",
            "value": "30m"
          },
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          },
          {
            "selected": false,
            "text": "6h",
            "value": "6h"
          },
          {
            "selected": false,
            "text": "12h",
            "value": "12h"
          },
          {
            "selected": false,
            "text": "1d",
            "value": "1d"
          }
        ],
        "auto": true,
        "auto_count": 30,
        "auto_min": "5m",
        "current": {
          "text": "auto",
          "value": "$__auto_interval_interval"
        },
        "label": "Interval"
      },
      {
        "name": "pe",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_exporter_nodes,alias)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_exporter_nodes,alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "PE"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_server_filesync_operations_total,host)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_server_filesync_operations_total,host)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "label": "Host"
      },
      {
        "name": "puppetserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},puppet_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "scmserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},scm_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      },
      {
        "name": "cd4peserver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
        "query": {
          "qryType": 1,
          "query": "label_values(puppet_infrastructure_config{alias=~\"${pe}\"},cd4pe_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Commit",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(puppet_server_filesync_duration_seconds{side=\"storage\",operation=\"commit\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 5
              },
              {
                "color": "#d03b3b",
                "value": 30
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "The primary writing new code into the file sync repository. First step of the journey.",
      "id": 789006782
    },
    {
