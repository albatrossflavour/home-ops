    {
      "title": "Live Dir Update",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(puppet_server_filesync_duration_seconds{side=\"client\",operation=\"live-dir-update\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 5
              },
              {
                "color": "#d03b3b",
                "value": 30
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Swapping the new code into the directory the compiler actually serves from. Last step: after this the compiler is on the new code.",
      "id": 1177969373
    },
    {
      "title": "Clone Rate",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(puppet_server_filesync_operations_total{side=\"client\",operation=\"clones\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}[$interval])) or (vector(0) and on() (count(puppet_server_filesync_operations_total{host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"}) > 0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 0.0001
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Compilers re-cloning the whole repository rather than fetching the difference. Expected once when a compiler is new, and a fault every other time: it is slow, and it is what the Clone series on the detail panels will be spiking on.",
      "id": 114487776
    },
    {
      "title": "Waiting for a JRuby",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(puppet_server_jruby_wait_seconds{host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e949f",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 0
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Borrowed from Puppetserver, because it is the symptom this board explains. If this is high and the Sync tile is high at the same moment, the deploy is what stalled your agents.",
      "id": 1658991874
    },
    {
      "title": "Is a sync stalling compiles?",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": [],
      "id": 176654909
    },
    {
      "title": "Sync Duration Against JRuby Wait",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(puppet_server_filesync_duration_seconds{side=\"client\",operation=\"sync\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "Sync duration",
          "refId": "A"
        },
        {
          "expr": "max(puppet_server_filesync_duration_seconds{side=\"client\",operation=\"clone\",host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "Clone duration",
          "refId": "B"
        },
        {
          "expr": "max(puppet_server_jruby_wait_seconds{host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "JRuby wait",
          "refId": "C"
        },
        {
          "expr": "max(puppet_server_jruby_borrow_seconds{host=~\"${host}\",alias=~\"${pe}\",job=~\"${pdctng_job}\"})",
          "legendFormat": "JRuby hold",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
