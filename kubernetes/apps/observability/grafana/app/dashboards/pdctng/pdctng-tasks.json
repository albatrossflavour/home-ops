    {
      "title": "History Window",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "time() - min(puppet_orchestrator_job_start_timestamp{alias=~\"${pe}\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
