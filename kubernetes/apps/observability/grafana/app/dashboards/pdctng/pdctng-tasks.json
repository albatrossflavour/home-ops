      "description": "Age of the oldest run the collector is still tracking. Nothing on this board can show you anything older, whatever the time picker says. If this is shorter than the period you care about, raise the orchestrator jobs limit.",
      "id": 1310124661
    },
    {
      "title": "Task runs",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": [],
      "id": 969933630
    },
    {
      "title": "Recent Task Runs",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(1000 * puppet_orchestrator_job_start_timestamp{task_name=~\"${task}\",alias=~\"${pe}\"} * on(job_id, task_name, alias) group_left(environment, owner, state) puppet_orchestrator_job_info{command=\"task\",task_name=~\"${task}\",alias=~\"${pe}\"}) >= ${__from} <= ${__to}",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Job ID"
            },
            "properties": [
              {
                "id": "custom.minWidth",
                "value": 260
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in PE console",
                    "url": "https://${puppetserver}/#/orchestration/tasks/task/${__data.fields[\"Job ID\"]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Owner"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Environment"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 112
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "finished": {
                        "color": "green",
                        "index": 0
                      },
                      "success": {
                        "color": "green",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "index": 2
                      },
                      "failure": {
                        "color": "red",
                        "index": 3
                      },
                      "running": {
                        "color": "blue",
                        "index": 4
                      },
                      "stopping": {
                        "color": "orange",
                        "index": 5
                      },
                      "stopped": {
                        "color": "orange",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              },
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ]
      },
      "description": "Runs started inside the dashboard time range. The collector tracks the 50 most recent per orchestrator, which caps how far back this reaches.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(job_id|task_name|owner|environment|state|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "job_id": "Job ID",
              "task_name": "Task",
              "owner": "Owner",
              "environment": "Environment",
              "state": "State",
              "Value": "Started"
            },
            "indexByName": {
              "job_id": 0,
              "task_name": 1,
              "owner": 2,
              "environment": 3,
              "state": 4,
              "Value": 5
            }
          }
        }
      ],
      "id": 382381950
    },
