            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "locale",
          "min": 0,
          "noValue": "No windows_exporter, or a Linux host"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Threads waiting for a processor, sampled rather than averaged. Windows only, and the counterpart to Load Average beside it. Read the shape: Windows publishes no averaged form of this, so a single spike is normal and a line that stays up is the finding.",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(.*?)([^\\s.]+)\\.[A-Za-z0-9.:-]+$",
            "renamePattern": "$1$2"
          }
        }
      ],
      "id": 558687127
    },
    {
      "title": "Memory",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "panels": [],
      "id": 1472122745
    },
    {
      "title": "Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{instance=~\"${instance}\",job=~\"${node_job}\"}",
          "legendFormat": "Total {{instance}}",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{instance=~\"${instance}\",job=~\"${node_job}\"}",
          "legendFormat": "Available {{instance}}",
          "refId": "B"
