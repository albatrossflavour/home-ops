{
  "uid": "trivy-vulnerabilities",
  "title": "Trivy Vulnerability Posture",
  "description": "Image vulnerability and misconfiguration posture from trivy-operator. Counts are deduplicated by image_digest wherever a total is shown, because trivy_image_vulnerabilities emits one series per workload and images shared between workloads would otherwise be counted repeatedly.",
  "tags": [
    "trivy",
    "security",
    "vulnerabilities"
  ],
  "timezone": "",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Current exposure",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Critical",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Distinct CRITICAL vulnerabilities across all scanned images, deduplicated by image_digest. The raw sum() is higher (224 vs 183 when written) because one image used by several workloads is reported once per workload. This panel counts the image, not the deployment.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(max by (image_digest) (trivy_image_vulnerabilities{severity=\"Critical\"}))",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "High",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Distinct HIGH vulnerabilities, deduplicated by image_digest, same caveat as Critical.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(max by (image_digest) (trivy_image_vulnerabilities{severity=\"High\"}))",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "Fixable CRITICAL",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "The metric behind TrivyFixableCriticalBacklog. Pushed once daily at 06:15 by the trivy-fixable-check CronJob via cert-expiry-pushgateway, which runs WITHOUT --persistence.file. Any pushgateway restart drops this to No Data until the next 06:15 run, and the alert silently stops firing while the backlog is unchanged. If this reads No Data, that is the reason, not a clean bill of health.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "trivy_critical_fixable_total",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "title": "Images scanned",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Distinct image digests with a VulnerabilityReport.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "count(count by (image_digest) (trivy_image_vulnerabilities))",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "title": "Exposed secrets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Findings from Trivy's secret scanner across all images. Any non-zero value is worth reading directly: kubectl get exposedsecretreports -A",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(max by (image_digest) (trivy_image_exposedsecrets))",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Where the risk is",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Critical by namespace",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Deduplicated within each namespace, so an image running twice in one namespace counts once. An image in two namespaces counts in both, which is correct: it needs fixing in both places.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (namespace) (max by (namespace, image_digest) (trivy_image_vulnerabilities{severity=\"Critical\"}))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 7,
      "title": "Top images by Critical count",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "The actual work queue. Each bar is one image; fixing the pin usually clears the whole bar.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "topk(12, max by (image_repository) (trivy_image_vulnerabilities{severity=\"Critical\"}))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{image_repository}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Trend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Critical and High over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Deduplicated by image. Steps rather than curves are normal: counts only move when Trivy rescans an image or a workload changes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(max by (image_digest) (trivy_image_vulnerabilities{severity=\"Critical\"}))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "Critical"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum(max by (image_digest) (trivy_image_vulnerabilities{severity=\"High\"}))",
          "refId": "B",
          "format": "time_series",
          "legendFormat": "High"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Critical by namespace over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "Which namespace a regression landed in. Flat lines that step down are fixes landing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (namespace) (max by (namespace, image_digest) (trivy_image_vulnerabilities{severity=\"Critical\"}))",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Other Trivy findings",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Config audit findings by namespace",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "trivy_resource_configaudits, Trivy's own workload misconfiguration checks. Overlaps with Kyverno's Pod Security Standards policies but is not identical, and unlike Kyverno it also inspects image and filesystem settings. Low severity dominates and is mostly noise.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (namespace) (trivy_resource_configaudits{severity=~\"Critical|High\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 11,
      "title": "RBAC findings by severity",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "description": "trivy_role_rbacassessments plus trivy_clusterrole_clusterrbacassessments. Related to the cis-5-1-3-no-wildcard-rbac Kyverno policy but broader. Summed via a __name__ union rather than `a + on(severity) b`: the binary-operator form returns an empty result here because the two metrics carry different label sets, and it fails silently rather than erroring.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "expr": "sum by (severity) ({__name__=~\"trivy_(role_rbacassessments|clusterrole_clusterrbacassessments)\"})",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{severity}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    }
  ]
}
