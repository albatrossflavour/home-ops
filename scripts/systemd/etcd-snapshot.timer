# Installed by `task talos:maintenance:etcd-snapshot-timer`. Edit it here,
# not in ~/.config/systemd/user.
[Unit]
Description=Daily etcd snapshot to the NAS

[Timer]
# 17:20 UTC (04:20 AEDT). Clear of the Volsync windows: the daily run of 18
# sources at 00:00 UTC, and the four-hourly ones at 16:00 to 16:50 and 20:00.
OnCalendar=*-*-* 17:20:00 UTC
# If ponder was off at 17:20, run once when it next comes up.
Persistent=true

[Install]
WantedBy=timers.target
