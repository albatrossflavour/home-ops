{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'docker:pinDigests',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':automergeBranch',
  ],
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard 🤖',
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  schedule: [
    'every weekend',
  ],
  ignorePaths: [
    '**/*.sops.*',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  pip_requirements: {
    managerFilePatterns: [
      '/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/',
    ],
  },
  commitMessageTopic: '{{depName}}',
  commitMessageExtra: 'to {{newVersion}}',
  commitMessageSuffix: '',
  packageRules: [
    {
      description: [
        'Do not add digests to chart versions or Flux sources. Charts in OCI registries are looked up as docker, so docker:pinDigests would write version: 1.2.3@sha256:... into HelmRelease and helmfile chart versions, which neither accepts. The flux and helmfile managers only ever see charts and sources, never container images, so this is scoped by manager rather than by file name. A rule matching ocirepository.yaml and flux.yaml missed HelmReleases, the bootstrap helmfile and the ocirepository-*.yaml files. Digests already in an OCIRepository ref are still kept current.',
      ],
      matchManagers: [
        'flux',
        'helmfile',
      ],
      pinDigests: false,
    },
    {
      description: [
        'kube-prometheus-stack takes the thanos digest in its own sha: field. Renovate writes a pinned digest into tag: and leaves sha: alone, which renders a double-digest reference the kubelet cannot pull (#2096). Keep tag: a plain version.',
      ],
      matchFileNames: [
        'kubernetes/apps/observability/kube-prometheus-stack/app/helmrelease.yaml',
      ],
      matchPackageNames: [
        'quay.io/thanos/thanos',
      ],
      pinDigests: false,
    },
    {
      description: [
        'topf reads kubernetesVersion and talosVersion as plain versions and templates them into image references, so a digest there breaks the render.',
      ],
      matchFileNames: [
        'kubernetes/bootstrap/talos/topf/**',
      ],
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
        'ghcr.io/siderolabs/installer',
      ],
      pinDigests: false,
    },
    {
      description: [
        'Pin GitHub Actions to a commit SHA and keep the pin current',
      ],
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
    {
      description: [
        'Auto merge Github Actions',
      ],
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: [
        'Flux Group',
      ],
      groupName: 'Flux',
      matchDatasources: [
        'docker',
        'github-tags',
      ],
      versioning: 'semver',
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      separateMinorPatch: true,
      matchPackageNames: [
        '/fluxcd/',
      ],
    },
    {
      description: [
        'Talos Group',
      ],
      groupName: 'Talos',
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      separateMinorPatch: true,
      matchPackageNames: [
        '/siderolabs/talosctl/',
        '/siderolabs/installer/',
      ],
    },
    {
      description: [
        'Pin emqx-operator to 2.2.x - 2.3.0+ requires EMQX Enterprise 5.9+ with licence for clustering',
      ],
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'emqx-operator',
      ],
      allowedVersions: '<2.3.0',
    },
    {
      description: [
        'nocodb moved from 0.x to date versioning (0.301.5 -> 2026.04.0 in 2026-04). Renovate 44 added maxMajorIncrement with a default of 500 and treats that as a major jump of 2026, so it silently skipped every release since. Confirmed 2026-11-03 with a local dry-run: "Skipping nocodb/nocodb@2026.10.1 because major increment 2026 exceeds maxMajorIncrement 500". Remove once the pin is on a 2026.x tag.',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nocodb/nocodb',
      ],
      maxMajorIncrement: 0,
    },
    {
      description: [
        'Hold sonarr on v4 until upstream ships v5 as stable: every v5 release is a prerelease, and v5 migrates the database so a revert means a restore. Remove once v5 is stable.',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/sonarr',
      ],
      allowedVersions: '<5',
    },
    {
      description: [
        'Keep n8n on the stable release line. n8n ships three lines at once: 2.45.x is stable (the stable and latest tags both point at it), 2.46.x is beta (the beta and next tags), and 3.0.x is on no channel at all and has not moved since 2026-10-28 while the other three shipped. Renovate cannot see this, because ignoreUnstable only filters semver prerelease strings and 2.46.3 is clean semver, so without this cap it offers the beta and the major as ordinary updates. n8n also runs DB migrations on upgrade, so a revert is a Postgres restore rather than a rollback. Raise the cap deliberately when 2.46 becomes stable.',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'docker.n8n.io/n8nio/n8n',
      ],
      allowedVersions: '<2.46',
    },
    {
      matchDatasources: [
        'helm',
      ],
      commitMessageTopic: 'chart {{depName}}',
    },
    {
      matchDatasources: [
        'docker',
      ],
      commitMessageTopic: 'image {{depName}}',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(container)!: ',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'container',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'container',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'container',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(helm)!: ',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'helm',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'helm',
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(github-release)!: ',
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'github-release',
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'github-release',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(github-action)!: ',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'github-action',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'github-action',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'type/patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'renovate/container',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      addLabels: [
        'renovate/helm',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      addLabels: [
        'renovate/github-release',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'renovate/github-action',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: [
        'Process custom dependencies',
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+: (&\\S+\\s)?(?<currentValue>\\S+)',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
    {
      customType: 'regex',
      description: [
        "CloudNativePG Cluster imageName - repo:tag combined in one value, unlike the datasource=/depName= comment convention above which needs them split. Confirmed 2026-09-01 this field was invisible to Renovate for the cluster's entire lifetime (never touched since the file was first committed, not even a same-version build-string bump) - CNPG's imageName key isn't the standard \"image:\" key the default docker/kubernetes managers look for.",
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'imageName:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-fA-F0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
